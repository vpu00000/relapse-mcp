{
  "name": "relapse-mcp",
  "version": "0.1.0",
  "description": "MCP tools for Relapse Roblox sessions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "relapse-mcp": "dist/index.js",
    "roblox-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "scripts": {
    "build:connector": "darklua process connector-src/init.luau connector.luau",
    "build": "npm run build:connector && node scripts/build-server.mjs",
    "build:all": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm test",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vpu00000/relapse-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3"
  }
}
